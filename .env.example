# ==============================================================================
# RetireOps Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==============================================================================
# APPLICATION
# ==============================================================================
NODE_ENV=production
APP_NAME=RetireOps
APP_VERSION=1.0.0
APP_URL=http://localhost

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=retireops
DB_USER=retireops
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Full connection string (alternative to individual vars)
DATABASE_URL=postgresql://retireops:CHANGE_ME@postgres:5432/retireops

# ==============================================================================
# REDIS (Cache & Queue)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_32_CHARS_MIN
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth (for Next.js frontend)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS_MIN

# ==============================================================================
# ENCRYPTION
# ==============================================================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_64_HEX_CHARS

# ==============================================================================
# MONITORING
# ==============================================================================
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Sentry (Error Tracking) - Optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ==============================================================================
# EMAIL (Optional - for notifications)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@retireops.com

# ==============================================================================
# CLOUD STORAGE (Optional - for PDF storage)
# ==============================================================================
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=retireops-reports

# DigitalOcean Spaces (S3-compatible alternative)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=retireops

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Heavy computation limits
MONTE_CARLO_RATE_LIMIT_WINDOW_MS=60000  # 1 minute
MONTE_CARLO_RATE_LIMIT_MAX=10

# ==============================================================================
# WORKER CONFIGURATION
# ==============================================================================
WORKER_CONCURRENCY=5
WORKER_MAX_JOB_RETRIES=3
WORKER_JOB_TIMEOUT_MS=300000  # 5 minutes

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=info  # error, warn, info, debug
LOG_FORMAT=json  # json or simple

# ==============================================================================
# GOOGLE OAUTH
# ==============================================================================
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/callback/google

# ==============================================================================
# CORS
# ==============================================================================
CORS_ORIGIN=http://localhost:3000,https://retireops.com
ALLOWED_ORIGINS=http://localhost:3000,https://retireops.com

# ==============================================================================
# FEATURES FLAGS (Optional)
# ==============================================================================
ENABLE_MONTE_CARLO=true
ENABLE_PDF_REPORTS=true
ENABLE_SCENARIO_COMPARISON=true
ENABLE_OPTIMIZATION_ENGINE=false  # Phase 3 feature
ENABLE_REAL_ESTATE_MODELING=false  # Phase 3 feature

# ==============================================================================
# CACHE TTL (Time To Live in seconds)
# ==============================================================================
CACHE_TTL_PROJECTION=3600  # 1 hour
CACHE_TTL_TAX_TABLES=31536000  # 1 year
CACHE_TTL_BENEFIT_RATES=2592000  # 30 days
CACHE_TTL_USER_SESSION=86400  # 24 hours

# ==============================================================================
# DATABASE POOL SETTINGS
# ==============================================================================
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================
# Enable clustering for Node.js (use all CPU cores)
CLUSTER_MODE=false

# Memory limits
NODE_OPTIONS=--max-old-space-size=2048

# ==============================================================================
# DEVELOPMENT ONLY
# ==============================================================================
# Set to 'true' for detailed SQL logging
DEBUG_SQL=false

# Skip authentication (DEVELOPMENT ONLY!)
SKIP_AUTH=false

# Seed database with test data
SEED_DATABASE=false
