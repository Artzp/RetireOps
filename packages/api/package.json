{
  "name": "@retireops/api",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "RetireOps Express API Gateway",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@retireops/calculation-engine": "workspace:*",
    "@retireops/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "express-rate-limit": "^8.5.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^4.0.0",
    "rimraf": "^6.1.3",
    "supertest": "^6.3.4",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
