{
  "name": "@retireops/calculation-engine",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tax": {
      "types": "./dist/tax/index.d.ts",
      "import": "./dist/tax/index.js"
    },
    "./benefits": {
      "types": "./dist/benefits/index.d.ts",
      "import": "./dist/benefits/index.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "import": "./dist/accounts/index.js"
    },
    "./projection": {
      "types": "./dist/projection/index.d.ts",
      "import": "./dist/projection/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@retireops/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
