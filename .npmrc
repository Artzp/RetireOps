# Ensure pnpm resolves platform-specific optional dependencies for ALL
# target platforms when generating the lockfile, not just the host platform.
#
# Why this matters: Tailwind 4 ships @tailwindcss/oxide as a native Rust
# addon with per-platform binaries (linux-x64-gnu, win32-x64-msvc,
# darwin-arm64, etc). Without this, a lockfile generated on Windows omits
# the Linux binary and CI build fails with "Cannot find module
# '@tailwindcss/oxide-linux-x64-gnu'". Other native deps (esbuild,
# lightningcss, @swc/core) have the same shape.
#
# See: https://pnpm.io/npmrc#supportedarchitectures
supported-architectures.os[]=linux
supported-architectures.os[]=win32
supported-architectures.os[]=darwin
supported-architectures.cpu[]=x64
supported-architectures.cpu[]=arm64
supported-architectures.libc[]=glibc
supported-architectures.libc[]=musl
